APP_NAME=SportMatch Gateway
APP_VERSION=0.1.0
APP_ENV=development
SERVICE_NAME=sportmatch-gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Autenticación. No se incluye ninguna clave real.
AUTH_REQUIRED=true
JWT_ALGORITHM=HS256
JWT_ISSUER=sportmatch-auth
JWT_AUDIENCE=sportmatch-mobile
JWT_SECRET=
JWT_PUBLIC_KEY=
JWT_LEEWAY_SECONDS=5

# Protección HTTP.
ALLOWED_HOSTS=localhost,127.0.0.1,gateway,testserver
# Orígenes del sitio web permitidos (también para el WebSocket del chat), separados por coma.
# Sitio de clubes (sportmatch-web) en desarrollo: http://localhost:3000
CORS_ALLOWED_ORIGINS=
ENABLE_HSTS=false

# Gateway -> Ms_Users. Compose usa el DNS interno ms_users:8001.
USERS_SERVICE_URL=http://127.0.0.1:8001
USERS_TIMEOUT_SECONDS=10
JWT_ACCESS_TOKEN_MINUTES=30

# Docker Desktop -> PostgreSQL del Mac. Para ejecutar Python localmente,
# reemplazar host.docker.internal por localhost.
USERS_DATABASE_URL=postgresql://sportmach_users:replace-with-a-password@host.docker.internal:5432/sportmach_users

# Ms_Users -> correo de recuperación de contraseña (cualquier proveedor SMTP).
# Gmail: smtp.gmail.com:587 con una "contraseña de aplicación" en SMTP_PASSWORD.
# Outlook/Office 365: smtp.office365.com:587.
# EMAIL_BACKEND=console imprime el correo en los logs de ms_users (solo desarrollo).
EMAIL_BACKEND=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
EMAIL_FROM=
PASSWORD_RESET_CODE_MINUTES=15
PASSWORD_RESET_MAX_ATTEMPTS=5
PASSWORD_RESET_RESEND_SECONDS=60
# Solo desarrollo y solo con EMAIL_BACKEND=console: cualquier código de 6 dígitos verifica el correo.
EMAIL_VERIFICATION_ACCEPT_ANY_CODE=false
# Matching: base independiente de Users; host.docker.internal desde Docker.
MATCHING_DATABASE_URL=postgresql://sportmach_matching:CHANGE_ME@host.docker.internal:5432/sportmach_matching
# Opcional: avisos de ms-club (revisión de postulaciones y comunicados). Rol sportmatch_clubs.
# CLUBS_DATABASE_URL=postgresql://sportmatch_clubs:CHANGE_ME@host.docker.internal:5432/sportmatch_clubs

# Actividades: base independiente; puerto interno 8003.
ACTIVITIES_SERVICE_URL=http://127.0.0.1:8003

# Clubes, convocatorias, comunicados y pagos de planes con Webpay Plus (ms-club, puerto 8004).
# Vacío: las rutas /api/v1/clubs y /api/v1/payments responden 503 y /health/ready no lo espera.
# Compose: http://ms_club:8004
CLUBS_SERVICE_URL=http://127.0.0.1:8004
ACTIVITIES_DATABASE_URL=postgresql://sportmach_activities:CHANGE_ME@host.docker.internal:5432/sportmach_activities

# Notificaciones: Compose usa USERS_DATABASE_URL como almacén del esquema notifications.
# Habilitar envíos solo después de configurar EAS/FCM/APNs (docs/notificaciones.md).
PUSH_ENABLED=false
# Solo servidor; necesario si se habilita la seguridad mejorada de Expo Push.
EXPO_ACCESS_TOKEN=

# Webpay Plus: API real de integración, sin cobros reales.
WEBPAY_MOCK_MODE=false
WEBPAY_ENVIRONMENT=INTEGRATION
WEBPAY_COMMERCE_CODE=
WEBPAY_API_KEY=
WEBPAY_PUBLIC_URL=http://localhost:8000
WEBPAY_FRONTEND_RETURN_URL=sportmatchapp://pago
WEBPAY_WEB_RETURN_URL=http://localhost:3000/pago/resultado
